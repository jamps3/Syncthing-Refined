<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Syncthing" parent="Theme.Syncthing.Base">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@color/bottom_navigation_bar</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="alertDialogTheme">@style/Theme.Syncthing.Dialog</item>
    </style>

    <!-- Button themes -->
    <style name="Theme.Syncthing.GreyButton" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- Dialog themes -->
    <eat-comment/>

    <style name="Theme.Syncthing.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
